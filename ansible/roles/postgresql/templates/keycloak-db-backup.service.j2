# Managed by Ansible
[Unit]
Description=Backup of the Keycloak database (pg_dump)
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
# Dumps contain password hashes and user data: owner-only files.
UMask=0077
ExecStart=/usr/local/sbin/keycloak-db-backup
# Sandbox: read-only system except the backup directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths={{ postgresql_backup_dir }}
